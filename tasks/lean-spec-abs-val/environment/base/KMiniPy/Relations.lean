import KMiniPy.Rewrite

/-! # Many-step rewriting and reachability over the klean-generated `Rewrites`

`Rewrites` (generated by klean from the MINIPY-LEAN K semantics) is
one-or-more-step rewriting: one constructor per K rule plus a built-in
transitivity constructor `tran`. Every sample execution takes at least one
step, so execution theorems are stated with `Rewrites` directly. The
definitions below add the reflexive closure and pre/post reachability.
-/

/-- `⇒*`: zero or more steps, as a plain definition over `Rewrites`. -/
def MultiStep (a b : SortGeneratedTopCell) : Prop :=
  a = b ∨ Rewrites a b

/-- Divergence, definable over the transitive relation alone: every state
reachable from `a` (including `a` itself) can take at least one further
step; equivalently, the computation from `a` never reaches a stuck/final
state. -/
def Diverges (a : SortGeneratedTopCell) : Prop :=
  ∀ b, MultiStep a b → ∃ c, Rewrites b c

/-- Pre/post-condition reachability: ONE-PATH reachability. Either `a`
diverges, or it rewrites to `b` in finitely many steps. This is the
correct semantics for pre/post conditions and loop invariants on any
system; no determinism assumption is required. -/
def Reaches (a b : SortGeneratedTopCell) : Prop :=
  Diverges a ∨ MultiStep a b

/-- An execution (≥ 1 step) is in particular a reachability witness. -/
theorem Reaches.of_rewrites {a b : SortGeneratedTopCell}
    (h : Rewrites a b) : Reaches a b :=
  Or.inr (Or.inr h)

/-- Shorthand for integer values in statements. -/
abbrev iV (i : SortInt) : SortVal := SortVal.«intV(_)_MINIPY-LEAN-SYNTAX_Val_Int» i

abbrev sV (s : SortString) : SortVal := SortVal.«strV(_)_MINIPY-LEAN-SYNTAX_Val_String» s

/-- klean's Prelude applies `Int.emod`/`Int.ediv` as raw constants; `omega`
only recognizes the `%`/`/` notation heads. These `rfl` lemmas restore the
notation in simp-normalized goals (used by the path-theorem TACTIC for
programs whose arithmetic — Python `//`, `%` — must reach `omega`). -/
theorem intEmodEq (a b : Int) : Int.emod a b = a % b := rfl

theorem intEdivEq (a b : Int) : Int.ediv a b = a / b := rfl

/-- Interpretation of the klean String-equality hook. klean translates the
`STRING.eq` hook as a signature-only `axiom` (Func.lean) with no defining
equations, so any ground `lookup`/`update`/`flookup` call that must *skip* an
entry — and every `flookup` on a non-empty function table, whose generated
rule-branch order tries the skip rule first — is a stuck term no tactic can
reduce. This axiom supplies the standard semantics; it is consistent
(interpret the hook as `fun s t => some (s == t)`). Generated trace proofs
rewrite with it via `simp […, eqStringHook, …]`. -/
axiom eqStringHook (s t : SortString) :
  «_==String__STRING-COMMON_Bool_String_String» s t = some (s == t)
